{
  "manifest_version": 3,
  "name": "bilibili极简主页-隐藏b站(哔哩哔哩)主页推荐",
  "version": "1.2.2",
  "description": "将 Bilibili 根首页改为保留原生搜索与账户入口的极简主页。非官方扩展。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ]
}
